# ───────────────────────────────────────────────────────────────────────────
# QYRO Social Calendar — variables de entorno
# Copia este fichero a `.env` en la raíz y rellena con valores reales.
# Nunca commitees `.env`. Secrets reales viven en doppler/infisical en deploy.
# ───────────────────────────────────────────────────────────────────────────

NODE_ENV=development
TZ=Europe/Madrid

# ── API ──
API_HOST=0.0.0.0
API_PORT=3001
API_BASE_URL=http://localhost:3001
WEB_BASE_URL=http://localhost:5173

# Service-to-service API key usada por el Estudio Creativo (SESIÓN 2)
# para llamar a POST /api/v1/content-pieces/ingest. Genera con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INGEST_SERVICE_API_KEY=replace-me-with-64-hex-chars

# JWT para auth interna del admin (PWA)
# Genera con el mismo comando que INGEST_SERVICE_API_KEY
JWT_ACCESS_SECRET=replace-me
JWT_REFRESH_SECRET=replace-me-different
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Clave maestra para AES-256-GCM (encriptado de tokens IG/FB/TT en reposo)
# Debe ser exactamente 32 bytes en hex (64 chars)
TOKEN_ENCRYPTION_KEY=replace-me-with-64-hex-chars

# Admin inicial (creado por seed si no existe)
ADMIN_EMAIL=diego@qyro.app
ADMIN_PASSWORD=changeme-on-first-login

# ── Base de datos ──
DATABASE_URL=postgresql://qyro:qyro@localhost:5432/qyro_social_calendar?schema=public

# ── Redis (queue + cache) ──
REDIS_URL=redis://localhost:6379

# ── Object storage (S3-compatible: MinIO en dev, R2/B2 en prod) ──
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minio-admin
S3_SECRET_KEY=minio-admin-secret
S3_BUCKET_MEDIA=qyro-social-media
S3_FORCE_PATH_STYLE=true

# ── Meta (Instagram + Facebook) ──
# Pendiente de app review. Mock en desarrollo.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v21.0
META_OAUTH_REDIRECT_URI=http://localhost:3001/auth/callback/meta
META_WEBHOOK_VERIFY_TOKEN=replace-me
# Permisos requeridos (informativo, no se leen):
# instagram_content_publish, instagram_manage_insights, pages_show_list,
# pages_read_engagement, pages_manage_posts, ads_management, business_management

# ── TikTok ──
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_OAUTH_REDIRECT_URI=http://localhost:3001/auth/callback/tiktok
TIKTOK_WEBHOOK_SECRET=replace-me
# Scopes: video.publish, video.upload, user.info.basic, business.creator.insights

# ── Kill switches de gasto (boost) ──
# Hard limits enforced antes de crear cualquier ad. Si se rechazan, se loguea.
BUDGET_DAILY_CAP_EUR=5
BUDGET_MONTHLY_CAP_EUR=150

# ── Logs ──
LOG_LEVEL=info

# ── Worker ──
WORKER_PUBLISH_CONCURRENCY=4
WORKER_METRICS_CONCURRENCY=2
