// QYRO Social Calendar — schema completo
//
// Convenciones:
//   - IDs: cuid() para URLs amigables y orden temporal.
//   - timestamps: created_at + updated_at en todas las entidades de dominio.
//   - JSON: usado sólo para datos opacos (métricas crudas, params de reglas QC,
//     metadata del estudio creativo). Lo estructurable va en columnas tipadas.
//   - Cascadas: borrar una pieza borra sus variantes, jobs y métricas. No se borran
//     campañas ni personas en cascada.

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Auth (admin de la PWA — single-tenant)
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String
  displayName   String
  isAdmin       Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Cuentas sociales conectadas
// ─────────────────────────────────────────────────────────────────────────────

enum Platform {
  instagram
  facebook
  tiktok
}

enum SocialAccountStatus {
  ACTIVE
  NEEDS_REAUTH
  REVOKED
  ERROR
}

model SocialAccount {
  id                    String              @id @default(cuid())
  platform              Platform
  handle                String
  // Meta-specific
  businessId            String?
  pageId                String?
  igUserId              String?
  // TikTok-specific
  ttAdvertiserId        String?
  // Tokens cifrados con AES-256-GCM (TOKEN_ENCRYPTION_KEY)
  accessTokenEncrypted  String
  refreshTokenEncrypted String?
  tokenExpiresAt        DateTime?
  status                SocialAccountStatus @default(ACTIVE)
  lastError             String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  variants PlatformVariant[]

  @@unique([platform, handle])
}

// ─────────────────────────────────────────────────────────────────────────────
// Buyer Personas y Campañas
// ─────────────────────────────────────────────────────────────────────────────

model BuyerPersona {
  id                 String                     @id
  name               String
  ageRange           String
  pains              String[]
  jtbdFunctional     String
  jtbdEmotional      String
  jtbdSocial         String
  tone               String
  preferredPlatforms String[]
  workingHooks       String[]
  isProTarget        Boolean                    @default(false)
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  contentPieces      ContentPieceBuyerPersona[]
}

model Campaign {
  id            String         @id @default(cuid())
  name          String
  objective     String
  startAt       DateTime
  endAt         DateTime?
  kpi           String?
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  contentPieces ContentPiece[]
}

// ─────────────────────────────────────────────────────────────────────────────
// Piezas de contenido + variantes por plataforma
// ─────────────────────────────────────────────────────────────────────────────

enum ContentFormat {
  image
  carousel
  reel
  ugc_video
  app_demo
  lifestyle_ad
}

enum ContentStatus {
  DRAFT
  IN_REVIEW
  CHANGES_REQUESTED
  REJECTED
  APPROVED
  SCHEDULED
  PUBLISHED
  ANALYZED
  FAILED
}

enum BoostObjective {
  REACH
  VIDEO_VIEWS
  TRAFFIC
  CONVERSIONS
  FOLLOWERS
}

model ContentPiece {
  id                    String          @id @default(cuid())
  /// UUID enviado por el Estudio Creativo (SESIÓN 2). Garantiza idempotencia.
  externalRef           String?         @unique
  title                 String
  format                ContentFormat
  status                ContentStatus   @default(DRAFT)
  campaignId            String?
  campaign              Campaign?       @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  conceptId             String?
  frameworkUsed         String?
  hookUsed              String?
  qcChecklistJson       Json?
  /// Presupuesto opcional de boost. Si > 0, al pasar a PUBLISHED se encola job de boost.
  boostBudgetEur        Decimal?        @db.Decimal(8, 2)
  boostDurationDays     Int?
  boostObjective        BoostObjective?
  boostAudiencePresetId String?
  boostAudiencePreset   AudiencePreset? @relation(fields: [boostAudiencePresetId], references: [id], onDelete: SetNull)
  creativeRunMetadata   Json?
  createdBy             String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  buyerPersonas ContentPieceBuyerPersona[]
  variants      PlatformVariant[]
  auditLogs     AuditLog[]

  @@index([status])
  @@index([campaignId])
  @@index([createdAt])
}

/// Tabla pivote ContentPiece ↔ BuyerPersona (N:M).
model ContentPieceBuyerPersona {
  contentPieceId String
  buyerPersonaId String
  contentPiece   ContentPiece @relation(fields: [contentPieceId], references: [id], onDelete: Cascade)
  buyerPersona   BuyerPersona @relation(fields: [buyerPersonaId], references: [id], onDelete: Cascade)

  @@id([contentPieceId, buyerPersonaId])
}

enum PlatformVariantKind {
  tiktok
  instagram_reel
  instagram_feed
  instagram_story
  facebook_feed
  facebook_reel
}

enum MediaType {
  image
  video
  carousel
}

model PlatformVariant {
  id              String              @id @default(cuid())
  contentPieceId  String
  contentPiece    ContentPiece        @relation(fields: [contentPieceId], references: [id], onDelete: Cascade)
  /// Variante específica (placement). `tiktok`, `instagram_reel`, etc.
  kind            PlatformVariantKind
  mediaUrl        String
  mediaType       MediaType
  ratio           String
  durationS       Int?
  caption         String?
  hashtags        String[]
  firstComment    String?
  musicRef        String?
  scheduledAt     DateTime?
  publishedAt     DateTime?
  /// ID del post en la red (devuelto por la API tras publicar con éxito).
  platformPostId  String?
  /// ID interno del vídeo en la red (necesario para Spark Ads en TikTok).
  platformVideoId String?
  socialAccountId String?
  socialAccount   SocialAccount?      @relation(fields: [socialAccountId], references: [id], onDelete: SetNull)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  publishJobs PublishJob[]
  adCampaigns AdCampaign[]
  metrics     Metric[]

  @@unique([contentPieceId, kind])
  @@index([scheduledAt])
  @@index([kind])
}

// ─────────────────────────────────────────────────────────────────────────────
// Publishing jobs (worker BullMQ)
// ─────────────────────────────────────────────────────────────────────────────

enum PublishJobStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  CANCELLED
}

model PublishJob {
  id                String           @id @default(cuid())
  platformVariantId String
  platformVariant   PlatformVariant  @relation(fields: [platformVariantId], references: [id], onDelete: Cascade)
  status            PublishJobStatus @default(PENDING)
  attempt           Int              @default(0)
  lastError         String?
  /// Container ID temporal de Meta (fase de creación de container antes de publicar).
  containerId       String?
  scheduledAt       DateTime
  publishedAt       DateTime?
  /// hash(content_piece_id + platform + scheduled_at) — bloquea duplicados.
  idempotencyKey    String           @unique
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([status, scheduledAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Boost / Ads
// ─────────────────────────────────────────────────────────────────────────────

enum AdCampaignStatus {
  PENDING
  ACTIVE
  PAUSED
  COMPLETED
  FAILED
}

model AdCampaign {
  id                  String           @id @default(cuid())
  platformVariantId   String
  platformVariant     PlatformVariant  @relation(fields: [platformVariantId], references: [id], onDelete: Cascade)
  platform            Platform
  /// Referencias externas (Meta Marketing API / TikTok Marketing API).
  externalCampaignId  String?
  externalAdsetId     String?
  externalAdId        String?
  dailyBudgetCents    Int?
  lifetimeBudgetCents Int?
  status              AdCampaignStatus @default(PENDING)
  startedAt           DateTime?
  endedAt             DateTime?
  spendCents          Int              @default(0)
  audiencePresetId    String?
  audiencePreset      AudiencePreset?  @relation(fields: [audiencePresetId], references: [id], onDelete: SetNull)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([status])
  @@index([startedAt])
}

/// Registro diario de gasto en boost — usado por el kill switch para enforcement.
/// Se reconcilia contra Meta/TT diariamente.
model BoostSpendLedger {
  id             String   @id @default(cuid())
  /// Día (YYYY-MM-DD en TZ del sistema). Único para upsert.
  date           DateTime @db.Date
  platform       Platform
  spendCents     Int      @default(0)
  /// `committed_cents` cuenta presupuestos ya encolados pendientes de gasto real.
  committedCents Int      @default(0)
  updatedAt      DateTime @updatedAt

  @@unique([date, platform])
}

model AudiencePreset {
  id                    String   @id
  name                  String
  geo                   String[]
  ageMin                Int
  ageMax                Int
  languages             String[]
  interestsMeta         String[]
  interestsTiktok       String[] @default([])
  behaviors             String[]
  placementsRecommended String[]
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  adCampaigns   AdCampaign[]
  contentPieces ContentPiece[]
}

// ─────────────────────────────────────────────────────────────────────────────
// Métricas
// ─────────────────────────────────────────────────────────────────────────────

enum MetricKind {
  ORGANIC
  PAID
}

model Metric {
  id                String          @id @default(cuid())
  platformVariantId String
  platformVariant   PlatformVariant @relation(fields: [platformVariantId], references: [id], onDelete: Cascade)
  fetchedAt         DateTime        @default(now())
  kind              MetricKind
  /// Métricas crudas tal cual las devuelve la red (impressions, reach, likes, ...).
  dataJson          Json

  @@index([platformVariantId, fetchedAt])
  @@index([kind])
}

// ─────────────────────────────────────────────────────────────────────────────
// QC Rules
// ─────────────────────────────────────────────────────────────────────────────

enum QCRuleType {
  HOOK_IN_3S
  CTA_PRESENT
  HASHTAG_LIMIT
  CAPTION_TYPOS
  MUSIC_LICENSE
  THUMBNAIL_TEXT_READABLE
  PLATFORM_DURATION
  PLATFORM_RATIO
  CUSTOM_SCRIPT
}

enum QCRuleSeverity {
  BLOCKER
  WARNING
  INFO
}

model QCRule {
  id                 String                @id @default(cuid())
  name               String
  description        String?
  appliesToFormats   ContentFormat[]
  appliesToPlatforms PlatformVariantKind[]
  ruleType           QCRuleType
  paramsJson         Json?
  severity           QCRuleSeverity        @default(WARNING)
  enabled            Boolean               @default(true)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// AuditLog (cambios de estado)
// ─────────────────────────────────────────────────────────────────────────────

model AuditLog {
  id             String        @id @default(cuid())
  entityType     String
  entityId       String
  fromStatus     String?
  toStatus       String?
  actorUserId    String?
  actor          User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  comment        String?
  metadataJson   Json?
  contentPieceId String?
  contentPiece   ContentPiece? @relation(fields: [contentPieceId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())

  @@index([entityType, entityId])
  @@index([contentPieceId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Notificaciones (push in-app + futuros canales)
// ─────────────────────────────────────────────────────────────────────────────

enum NotificationChannelKind {
  PUSH
  EMAIL
  SLACK
  TELEGRAM
  WEBHOOK
}

model NotificationChannel {
  id               String                  @id @default(cuid())
  kind             NotificationChannelKind
  target           String
  eventsSubscribed String[]
  active           Boolean                 @default(true)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
}

model NotificationDelivery {
  id          String                  @id @default(cuid())
  channelKind NotificationChannelKind
  event       String
  payloadJson Json
  /// `null` mientras está pendiente; timestamp cuando se ha entregado.
  deliveredAt DateTime?
  readAt      DateTime?
  createdAt   DateTime                @default(now())

  @@index([deliveredAt])
  @@index([readAt])
}
