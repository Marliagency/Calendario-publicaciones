// QYRO Social Calendar — schema completo v2 (multi-workspace)
//
// Convenciones:
//   - IDs: cuid() para URLs amigables y orden temporal.
//   - timestamps: createdAt + updatedAt en todas las entidades de dominio.
//   - JSON: usado sólo para datos opacos. Lo estructurable va en columnas tipadas.
//   - Cascadas: borrar un workspace borra todo su contenido (ON DELETE CASCADE).
//   - Aislamiento: TODA query de contenido lleva workspaceId en el WHERE.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Auth (admin de la PWA)
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id               String            @id @default(cuid())
  email            String            @unique
  passwordHash     String
  displayName      String
  isAdmin          Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  refreshTokens    RefreshToken[]
  auditLogs        AuditLog[]
  workspaceMembers WorkspaceMember[]
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Workspaces (multi-tenancy)
// ─────────────────────────────────────────────────────────────────────────────

enum WorkspaceStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum WorkspaceRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

model Workspace {
  id                  String          @id @default(cuid())
  slug                String          @unique
  name                String
  description         String?
  brandColorPrimary   String          @default("#3B82F6")
  brandColorSecondary String          @default("#7C5CFC")
  brandLogoUrl        String?
  defaultTimezone     String          @default("Europe/Madrid")
  defaultLanguage     String          @default("es-ES")
  dailyBoostCapEur    Decimal         @default(5) @db.Decimal(8, 2)
  monthlyBoostCapEur  Decimal         @default(150) @db.Decimal(8, 2)
  status              WorkspaceStatus @default(ACTIVE)
  createdByUserId     String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  members          WorkspaceMember[]
  apiKeys          WorkspaceApiKey[]
  socialAccounts   SocialAccount[]
  contentPieces    ContentPiece[]
  buyerPersonas    BuyerPersona[]
  campaigns        Campaign[]
  qcRules          QCRule[]
  auditLogs        AuditLog[]
  notifications             NotificationChannel[]
  audiencePresets           AudiencePreset[]
  spendLedger               BoostSpendLedger[]
  notificationDeliveries    NotificationDelivery[]
  adCampaigns               AdCampaign[]
}

model WorkspaceMember {
  id           String        @id @default(cuid())
  workspaceId  String
  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         WorkspaceRole @default(EDITOR)
  invitedAt    DateTime      @default(now())
  acceptedAt   DateTime?
  lastActiveAt DateTime?

  @@unique([workspaceId, userId])
  @@index([userId])
}

/// Claves de API por workspace para la integración con el Estudio Creativo (ingest).
/// La clave raw se muestra UNA sola vez; aquí sólo se guarda el hash SHA-256.
model WorkspaceApiKey {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  keyHash     String    @unique
  prefix      String    // primeros 12 chars de la clave raw (identificación visual)
  name        String    @default("Estudio Creativo")
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Cuentas sociales conectadas
// ─────────────────────────────────────────────────────────────────────────────

enum Platform {
  instagram
  facebook
  tiktok
}

enum SocialAccountStatus {
  ACTIVE
  NEEDS_REAUTH
  REVOKED
  ERROR
}

model SocialAccount {
  id                    String              @id @default(cuid())
  workspaceId           String
  workspace             Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  platform              Platform
  handle                String
  businessId            String?
  pageId                String?
  igUserId              String?
  ttAdvertiserId        String?
  accessTokenEncrypted  String
  refreshTokenEncrypted String?
  tokenExpiresAt        DateTime?
  status                SocialAccountStatus @default(ACTIVE)
  lastError             String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  variants PlatformVariant[]

  // Misma cuenta (handle+platform) sólo puede estar en un workspace a la vez.
  @@unique([platform, handle])
  @@index([workspaceId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Buyer Personas y Campañas
// ─────────────────────────────────────────────────────────────────────────────

model BuyerPersona {
  id                 String                     @id @default(cuid())
  workspaceId        String
  workspace          Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name               String
  ageRange           String
  pains              String[]
  jtbdFunctional     String
  jtbdEmotional      String
  jtbdSocial         String
  tone               String
  preferredPlatforms String[]
  workingHooks       String[]
  isProTarget        Boolean                    @default(false)
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  contentPieces      ContentPieceBuyerPersona[]

  @@index([workspaceId])
}

model Campaign {
  id            String         @id @default(cuid())
  workspaceId   String
  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name          String
  objective     String
  startAt       DateTime
  endAt         DateTime?
  kpi           String?
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  contentPieces ContentPiece[]

  @@index([workspaceId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Piezas de contenido + variantes por plataforma
// ─────────────────────────────────────────────────────────────────────────────

enum ContentFormat {
  image
  carousel
  reel
  ugc_video
  app_demo
  lifestyle_ad
}

enum ContentStatus {
  DRAFT
  IN_REVIEW
  CHANGES_REQUESTED
  REJECTED
  APPROVED
  SCHEDULED
  PUBLISHED
  ANALYZED
  FAILED
}

enum BoostObjective {
  REACH
  VIDEO_VIEWS
  TRAFFIC
  CONVERSIONS
  FOLLOWERS
}

model ContentPiece {
  id                    String          @id @default(cuid())
  workspaceId           String
  workspace             Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// UUID enviado por el Estudio Creativo. Garantiza idempotencia por workspace.
  externalRef           String?
  title                 String
  format                ContentFormat
  status                ContentStatus   @default(DRAFT)
  campaignId            String?
  campaign              Campaign?       @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  conceptId             String?
  frameworkUsed         String?
  hookUsed              String?
  qcChecklistJson       Json?
  boostBudgetEur        Decimal?        @db.Decimal(8, 2)
  boostDurationDays     Int?
  boostObjective        BoostObjective?
  boostAudiencePresetId String?
  boostAudiencePreset   AudiencePreset? @relation(fields: [boostAudiencePresetId], references: [id], onDelete: SetNull)
  creativeRunMetadata   Json?
  createdBy             String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  buyerPersonas ContentPieceBuyerPersona[]
  variants      PlatformVariant[]
  auditLogs     AuditLog[]

  // externalRef único por workspace (distintos workspaces pueden tener el mismo ref).
  @@unique([workspaceId, externalRef])
  @@index([workspaceId, status])
  @@index([campaignId])
  @@index([createdAt])
}

model ContentPieceBuyerPersona {
  contentPieceId String
  buyerPersonaId String
  contentPiece   ContentPiece @relation(fields: [contentPieceId], references: [id], onDelete: Cascade)
  buyerPersona   BuyerPersona @relation(fields: [buyerPersonaId], references: [id], onDelete: Cascade)

  @@id([contentPieceId, buyerPersonaId])
}

enum PlatformVariantKind {
  tiktok
  instagram_reel
  instagram_feed
  instagram_story
  facebook_feed
  facebook_reel
}

enum MediaType {
  image
  video
  carousel
}

model PlatformVariant {
  id              String              @id @default(cuid())
  contentPieceId  String
  contentPiece    ContentPiece        @relation(fields: [contentPieceId], references: [id], onDelete: Cascade)
  kind            PlatformVariantKind
  mediaUrl        String
  mediaType       MediaType
  ratio           String
  durationS       Int?
  caption         String?
  hashtags        String[]
  firstComment    String?
  musicRef        String?
  scheduledAt     DateTime?
  publishedAt     DateTime?
  platformPostId  String?
  platformVideoId String?
  socialAccountId String?
  socialAccount   SocialAccount?      @relation(fields: [socialAccountId], references: [id], onDelete: SetNull)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  publishJobs PublishJob[]
  adCampaigns AdCampaign[]
  metrics     Metric[]

  @@unique([contentPieceId, kind])
  @@index([scheduledAt])
  @@index([kind])
}

// ─────────────────────────────────────────────────────────────────────────────
// Publishing jobs (worker BullMQ)
// ─────────────────────────────────────────────────────────────────────────────

enum PublishJobStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  CANCELLED
}

model PublishJob {
  id                String           @id @default(cuid())
  platformVariantId String
  platformVariant   PlatformVariant  @relation(fields: [platformVariantId], references: [id], onDelete: Cascade)
  status            PublishJobStatus @default(PENDING)
  attempt           Int              @default(0)
  lastError         String?
  containerId       String?
  scheduledAt       DateTime
  publishedAt       DateTime?
  idempotencyKey    String           @unique
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([status, scheduledAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Boost / Ads
// ─────────────────────────────────────────────────────────────────────────────

enum AdCampaignStatus {
  PENDING
  ACTIVE
  PAUSED
  COMPLETED
  FAILED
}

model AdCampaign {
  id                  String           @id @default(cuid())
  workspaceId         String
  workspace           Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  platformVariantId   String
  platformVariant     PlatformVariant  @relation(fields: [platformVariantId], references: [id], onDelete: Cascade)
  platform            Platform
  externalCampaignId  String?
  externalAdsetId     String?
  externalAdId        String?
  dailyBudgetCents    Int?
  lifetimeBudgetCents Int?
  status              AdCampaignStatus @default(PENDING)
  startedAt           DateTime?
  endedAt             DateTime?
  spendCents          Int              @default(0)
  audiencePresetId    String?
  audiencePreset      AudiencePreset?  @relation(fields: [audiencePresetId], references: [id], onDelete: SetNull)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([workspaceId])
  @@index([status])
  @@index([startedAt])
}

/// Kill switch por workspace: (workspaceId, date, platform) únicos.
model BoostSpendLedger {
  id             String    @id @default(cuid())
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  date           DateTime  @db.Date
  platform       Platform
  spendCents     Int       @default(0)
  committedCents Int       @default(0)
  updatedAt      DateTime  @updatedAt

  @@unique([workspaceId, date, platform])
}

model AudiencePreset {
  id                    String    @id @default(cuid())
  workspaceId           String
  workspace             Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name                  String
  geo                   String[]
  ageMin                Int
  ageMax                Int
  languages             String[]
  interestsMeta         String[]
  interestsTiktok       String[]  @default([])
  behaviors             String[]
  placementsRecommended String[]
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  adCampaigns   AdCampaign[]
  contentPieces ContentPiece[]

  @@index([workspaceId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Métricas
// ─────────────────────────────────────────────────────────────────────────────

enum MetricKind {
  ORGANIC
  PAID
}

model Metric {
  id                String          @id @default(cuid())
  platformVariantId String
  platformVariant   PlatformVariant @relation(fields: [platformVariantId], references: [id], onDelete: Cascade)
  fetchedAt         DateTime        @default(now())
  kind              MetricKind
  dataJson          Json

  @@index([platformVariantId, fetchedAt])
  @@index([kind])
}

// ─────────────────────────────────────────────────────────────────────────────
// QC Rules
// ─────────────────────────────────────────────────────────────────────────────

enum QCRuleType {
  HOOK_IN_3S
  CTA_PRESENT
  HASHTAG_LIMIT
  CAPTION_TYPOS
  MUSIC_LICENSE
  THUMBNAIL_TEXT_READABLE
  PLATFORM_DURATION
  PLATFORM_RATIO
  CUSTOM_SCRIPT
}

enum QCRuleSeverity {
  BLOCKER
  WARNING
  INFO
}

model QCRule {
  id                 String                @id @default(cuid())
  workspaceId        String
  workspace          Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name               String
  description        String?
  appliesToFormats   ContentFormat[]
  appliesToPlatforms PlatformVariantKind[]
  ruleType           QCRuleType
  paramsJson         Json?
  severity           QCRuleSeverity        @default(WARNING)
  enabled            Boolean               @default(true)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@index([workspaceId])
}

// ─────────────────────────────────────────────────────────────────────────────
// AuditLog
// ─────────────────────────────────────────────────────────────────────────────

model AuditLog {
  id             String        @id @default(cuid())
  workspaceId    String?
  workspace      Workspace?    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  entityType     String
  entityId       String
  fromStatus     String?
  toStatus       String?
  actorUserId    String?
  actor          User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  comment        String?
  metadataJson   Json?
  contentPieceId String?
  contentPiece   ContentPiece? @relation(fields: [contentPieceId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())

  @@index([entityType, entityId])
  @@index([contentPieceId])
  @@index([workspaceId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Notificaciones
// ─────────────────────────────────────────────────────────────────────────────

enum NotificationChannelKind {
  PUSH
  EMAIL
  SLACK
  TELEGRAM
  WEBHOOK
}

model NotificationChannel {
  id               String                  @id @default(cuid())
  workspaceId      String
  workspace        Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  kind             NotificationChannelKind
  target           String
  eventsSubscribed String[]
  active           Boolean                 @default(true)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@index([workspaceId])
}

model NotificationDelivery {
  id          String                  @id @default(cuid())
  workspaceId String
  workspace   Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channelKind NotificationChannelKind
  event       String
  payloadJson Json
  deliveredAt DateTime?
  readAt      DateTime?
  createdAt   DateTime                @default(now())

  @@index([workspaceId])
  @@index([deliveredAt])
  @@index([readAt])
}
