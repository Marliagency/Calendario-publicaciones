{
  "name": "@qyro/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./server": "./src/server.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file ../../.env src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "11.0.2",
    "@fastify/cors": "10.0.2",
    "@fastify/helmet": "12.0.1",
    "@fastify/rate-limit": "10.2.1",
    "@fastify/sensible": "6.0.2",
    "@prisma/client": "5.22.0",
    "@qyro/db": "workspace:*",
    "@qyro/platform-adapters": "workspace:*",
    "@qyro/shared": "workspace:*",
    "argon2": "0.41.1",
    "bullmq": "5.34.0",
    "fastify": "5.2.0",
    "fastify-plugin": "5.0.1",
    "ioredis": "5.4.2",
    "jose": "5.9.6",
    "pino": "9.5.0",
    "pino-pretty": "13.0.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
