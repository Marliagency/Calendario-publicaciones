{
  "name": "@qyro/creative-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Estudio creativo agéntico de QYRO. Genera y empaqueta creatividades y las empuja a la cola del calendario.",
  "scripts": {
    "dev": "tsx --env-file=../../.env src/cli.ts",
    "dev:watch": "tsx watch --env-file=../../.env src/cli.ts",
    "cli": "tsx src/cli.ts",
    "build": "tsc",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@qyro/shared": "workspace:*",
    "pino": "9.5.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@qyro/api": "workspace:*",
    "@qyro/db": "workspace:*",
    "@types/node": "22.10.2",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
