{
  "name": "qyro-social-calendar",
  "version": "0.1.0",
  "private": true,
  "description": "Módulo de calendario social para QYRO: QC, scheduling, publicación a IG/FB/TikTok, boost y analítica.",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "db:generate": "pnpm --filter @qyro/db exec prisma generate",
    "db:migrate": "pnpm --filter @qyro/db exec prisma migrate dev",
    "db:reset": "pnpm --filter @qyro/db exec prisma migrate reset",
    "db:seed": "pnpm --filter @qyro/db exec tsx prisma/seed.ts",
    "db:studio": "pnpm --filter @qyro/db exec prisma studio",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "turbo": "2.3.3",
    "typescript": "5.7.2"
  }
}
